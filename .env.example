PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/messmate?sslmode=disable
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
# JWT access token lifetime in hours (720 = 30 days)
JWT_TTL_HOURS=720

# Email delivery for feedback and password resets (SMTP; e.g. Gmail App Password)
APP_BASE_URL=https://messmate-zhms.onrender.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FEEDBACK_EMAIL=
