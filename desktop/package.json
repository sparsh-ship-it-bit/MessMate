{
  "name": "messmate-desktop",
  "version": "1.0.12",
  "description": "MessMate desktop app for Windows and macOS",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check generate-icon.cjs && node --check generate-mac-icon.cjs",
    "dist:win": "npm run build:icon && npm run build:nova && electron-builder --win nsis --publish never",
    "release:win": "npm run build:icon && npm run build:nova && electron-builder --win nsis --publish always",
    "build:icon": "node generate-icon.cjs",
    "build:nova": "dotnet publish native/NovaBleHost.csproj -c Release -r win-x64 --self-contained true -o native/out",
    "dist:mac": "npm run build:icon && node generate-mac-icon.cjs && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.0.12",
    "sharp": "0.34.3",
    "png-to-ico": "2.1.8"
  },
  "build": {
    "appId": "com.messmate.desktop",
    "productName": "MessMate",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app-config.json",
      "splash.html",
      "package.json",
      "generate-icon.cjs",
      "assets/messmate.svg",
      "assets/messmate.ico",
      "generate-mac-icon.cjs",
      "assets/messmate.icns",
      "assets/messmate-icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MessMate-Setup-${version}.${ext}",
      "icon": "assets/messmate.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MessMate"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sparsh-ship-it-bit",
        "repo": "MessMate",
        "releaseType": "release"
      }
    ],
    "extraResources": [],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "MessMate-${version}-${arch}.${ext}",
      "icon": "assets/messmate.icns",
      "category": "public.app-category.business",
      "hardenedRuntime": false
    }
  }
}
