{
  "name": "messmate-desktop",
  "version": "1.0.3",
  "description": "MessMate Windows desktop app",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs",
    "dist:win": "npm run build:icon && electron-builder --win nsis --publish never",
    "release:win": "npm run build:icon && electron-builder --win nsis --publish always",
    "build:icon": "node generate-icon.cjs"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.0.12",
    "sharp": "0.34.3",
    "png-to-ico": "2.1.8"
  },
  "build": {
    "appId": "com.messmate.desktop",
    "productName": "MessMate",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app-config.json",
      "splash.html",
      "package.json",
      "generate-icon.cjs",
      "assets/messmate.svg",
      "assets/messmate.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MessMate-Setup-${version}.${ext}",
      "icon": "assets/messmate.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MessMate"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sparsh-ship-it-bit",
        "repo": "MessMate",
        "releaseType": "release"
      }
    ]
  }
}
